# eol=lf so a Windows checkout gets LF too, not just the index.
* text=auto eol=lf

# CRLF breaks a shebang, so keep this one explicit.
*.sh text eol=lf

# Uncomment per type used; exempt it in mixed-line-ending, set end_of_line = crlf in .editorconfig.

# cmd.exe misreads labels in LF-only batch files, so goto and call :label misfire.
# *.bat text eol=crlf
# *.cmd text eol=crlf

# Only for Authenticode-signed scripts: the signature covers the bytes, line endings included.
# *.ps1 text eol=crlf
